#!/bin/sh
# 校验提交信息格式，不符合就拒绝提交。
#
# 规范：type(scope): 描述
#   type   feat | fix | docs | refactor | test | chore | perf | build | ci | style
#   scope  可选，小写
#   描述   中文或英文，首行不超过 80 字符
#
# 为什么用钩子而不是写在文档里：文档没人看，钩子每次都拦。
# 历史提交里已经出现过「fix: 修」这种以后完全查不到改了什么的信息。

MSG_FILE="$1"
FIRST_LINE=$(head -n 1 "$MSG_FILE")

# 合并提交、revert 提交放行
case "$FIRST_LINE" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*) exit 0 ;;
esac

PATTERN='^(feat|fix|docs|refactor|test|chore|perf|build|ci|style)(\([a-z0-9._/-]+\))?: .{4,}'
if ! printf '%s' "$FIRST_LINE" | grep -qE "$PATTERN"; then
  echo ""
  echo "✘ 提交信息不符合规范："
  echo "    $FIRST_LINE"
  echo ""
  echo "  期望格式：type(scope): 描述"
  echo "  type 可选：feat fix docs refactor test chore perf build ci style"
  echo "  示例：feat(app): 字幕外观设置；fix(translate): 空译文"
  echo ""
  exit 1
fi

LEN=$(printf '%s' "$FIRST_LINE" | wc -m | tr -d ' ')
if [ "$LEN" -gt 80 ]; then
  echo "✘ 提交信息首行 $LEN 字符，超过 80。请把细节放到正文。"
  exit 1
fi

exit 0
